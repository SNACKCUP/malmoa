# 브라우저에서 호출할 API 기본 경로 (기본값 /api → next.config.ts 프록시가 백엔드로 전달)
NEXT_PUBLIC_API_BASE_URL=/api
# /api 프록시가 전달할 백엔드 주소
API_PROXY_TARGET=http://localhost:8000
# 웰컴 페이지의 Docs 버튼이 여는 주소 (사용 설명서 사이트). 비우면 버튼이 보이지 않습니다
NEXT_PUBLIC_DOCS_URL=
# GitHub 저장소 주소
NEXT_PUBLIC_GITHUB_URL=https://github.com/SNACKCUP/meerkit

# 공유 미리보기(og:image)와 검색 노출에 쓰는 사이트 주소. 배포 주소로 바꾸세요
NEXT_PUBLIC_SITE_URL=http://localhost:3000
