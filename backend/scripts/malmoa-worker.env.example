# 말모아 Mac 작업자 설정 — ~/.malmoa-worker.env 로 복사하고 chmod 600 (scripts/malmoa_worker.py)
# 이 Mac 에는 DB 비밀번호·저장소 키를 두지 않는다. 아래 두 값이면 된다.

# 말모아 API 주소 (끝의 /api 없이). 예: https://malmoa-api.example.com
MALMOA_API_URL=
# 작업자 열쇠 (uv run python scripts/malmoa_worker.py new-token 로 만들고, 해시는 서버 .env 의 MALMOA_WORKER_TOKEN_HASH 에)
MALMOA_WORKER_TOKEN=

# 할 일을 묻는 시간 (요일 범위 시작-끝시, 끝 시는 포함하지 않음). 시간 밖에는 서버를 깨우지 않는다. 바로 하려면 --now
MALMOA_WORKER_HOURS=mon-fri 08-20
MALMOA_WORKER_TZ=Asia/Seoul
MALMOA_WORKER_POLL_SECONDS=90

# 변환 설정 (서버와 같은 이름)
WHISPER_MODEL=small
WHISPER_LANGUAGE=ko
SEGMENT_MINUTES=5
